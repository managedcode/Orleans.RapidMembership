<Project>

	<!-- Adapt Clockwork's package targets to load the task from its source-project output. -->
	<PropertyGroup>
		<ClockworkInstrumentationToolDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/Clockwork/src/Clockwork.Instrumentation.Build/bin/$(Configuration)/net10.0'))</ClockworkInstrumentationToolDirectory>
	</PropertyGroup>
	<UsingTask TaskName="Clockwork.Instrumentation.Build.ClockworkInstrumentTask"
			   AssemblyFile="$(ClockworkInstrumentationToolDirectory)/Clockwork.Instrumentation.Build.dll" />

	<Target Name="ClockworkSetInstrumentationDefaults">
		<PropertyGroup>
			<ClockworkSourceDirectory Condition="'$(ClockworkSourceDirectory)' == ''">$(TargetDir)</ClockworkSourceDirectory>
			<ClockworkEntryAssemblyName Condition="'$(ClockworkEntryAssemblyName)' == ''">$(TargetName)</ClockworkEntryAssemblyName>
			<ClockworkStagingDirectory Condition="'$(ClockworkStagingDirectory)' == ''">$(IntermediateOutputPath)clockwork/instrumented/</ClockworkStagingDirectory>
			<ClockworkManifestPath Condition="'$(ClockworkManifestPath)' == ''">$(IntermediateOutputPath)clockwork/clockwork.manifest.json</ClockworkManifestPath>
			<ClockworkModeStampPath Condition="'$(ClockworkModeStampPath)' == ''">$(IntermediateOutputPath)clockwork/clockwork.mode</ClockworkModeStampPath>
			<ClockworkConfigurationPath Condition="'$(ClockworkConfigurationPath)' == '' and Exists('$(MSBuildProjectDirectory)/clockwork.config.json')">$(MSBuildProjectDirectory)/clockwork.config.json</ClockworkConfigurationPath>
		</PropertyGroup>
	</Target>

	<Target Name="ClockworkComputeInstrumentationToolSignature"
			DependsOnTargets="ClockworkSetInstrumentationDefaults"
			Condition="'$(ClockworkInstrumentationEnabled)' == 'true'">
		<ItemGroup>
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Clockwork.Instrumentation.Build.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Clockwork.Instrumentation.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Clockwork.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Mono.Cecil.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Mono.Cecil.Mdb.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Mono.Cecil.Pdb.dll" />
			<ClockworkInstrumentationToolBinary Include="$(ClockworkInstrumentationToolDirectory)/Mono.Cecil.Rocks.dll" />
		</ItemGroup>
		<Error Condition="!Exists('%(ClockworkInstrumentationToolBinary.Identity)')"
			   Text="Clockwork instrumentation tool binary '%(ClockworkInstrumentationToolBinary.Identity)' was not built." />
		<GetFileHash Files="@(ClockworkInstrumentationToolBinary)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_ClockworkHashedInstrumentationToolBinary" />
		</GetFileHash>
		<PropertyGroup>
			<ClockworkInstrumentationToolBinaryHashes>@(_ClockworkHashedInstrumentationToolBinary->'%(Filename)%(Extension)=%(FileHash)', '|')</ClockworkInstrumentationToolBinaryHashes>
			<ClockworkInstrumentationToolSignatureInputPath>$(IntermediateOutputPath)clockwork/clockwork.tools.sha256-input</ClockworkInstrumentationToolSignatureInputPath>
		</PropertyGroup>
		<MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ClockworkInstrumentationToolSignatureInputPath)'))" />
		<WriteLinesToFile File="$(ClockworkInstrumentationToolSignatureInputPath)"
						  Lines="$(ClockworkInstrumentationToolBinaryHashes)"
						  Overwrite="true"
						  WriteOnlyWhenDifferent="true" />
		<GetFileHash Files="$(ClockworkInstrumentationToolSignatureInputPath)" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_ClockworkInstrumentationToolSignatureFile" />
		</GetFileHash>
		<PropertyGroup>
			<ClockworkInstrumentationToolSignature>@(_ClockworkInstrumentationToolSignatureFile->'%(FileHash)')</ClockworkInstrumentationToolSignature>
			<ClockworkInstrumentationIdentity>$(ClockworkInstrumentationMode)|$(ClockworkInstrumentationToolSignature)</ClockworkInstrumentationIdentity>
			<ClockworkSuccessPath Condition="'$(ClockworkSuccessPath)' == ''">$(IntermediateOutputPath)clockwork\clockwork.$(ClockworkInstrumentationMode).$(ClockworkInstrumentationToolSignature).success</ClockworkSuccessPath>
		</PropertyGroup>
		<Message Importance="normal"
				 Text="Clockwork: instrumentation tool signature $(ClockworkInstrumentationToolSignature)" />
	</Target>

	<Target Name="ClockworkWriteInstrumentationModeStamp"
			BeforeTargets="ClockworkInstrument"
			DependsOnTargets="ClockworkComputeInstrumentationToolSignature"
			Condition="'$(ClockworkInstrumentationEnabled)' == 'true'">
		<ReadLinesFromFile File="$(ClockworkModeStampPath)"
						   Condition="Exists('$(ClockworkModeStampPath)')">
			<Output TaskParameter="Lines" PropertyName="ClockworkPreviousInstrumentationIdentity" />
		</ReadLinesFromFile>
		<Delete Files="$(ClockworkSuccessPath);$(ClockworkManifestPath)"
				Condition="'$(ClockworkPreviousInstrumentationIdentity)' != '' and '$(ClockworkPreviousInstrumentationIdentity)' != '$(ClockworkInstrumentationIdentity)'" />
		<WriteLinesToFile File="$(ClockworkModeStampPath)"
						  Lines="$(ClockworkInstrumentationIdentity)"
						  Overwrite="true"
						  WriteOnlyWhenDifferent="true" />
	</Target>

	<Target Name="ClockworkInstrument"
			AfterTargets="Build"
			DependsOnTargets="ClockworkComputeInstrumentationToolSignature"
			Condition="'$(ClockworkInstrumentationEnabled)' == 'true'">

		<Message Importance="high" Text="Clockwork: instrumenting '$(ClockworkSourceDirectory)' -> '$(ClockworkStagingDirectory)'" />

		<ClockworkInstrumentTask
			SourceDirectory="$(ClockworkSourceDirectory)"
			StagingDirectory="$(ClockworkStagingDirectory)"
			ConfigurationPath="$(ClockworkConfigurationPath)"
			RuleSetPaths="@(ClockworkRuleSet)"
			BuiltInRuleSets="@(ClockworkBuiltInRuleSet)"
			BuiltInIncludeFamilies="@(ClockworkBuiltInInclude)"
			BuiltInExcludeFamilies="@(ClockworkBuiltInExclude)"
			IncludePatterns="@(ClockworkInclude)"
			ExcludePatterns="@(ClockworkExclude)"
			InstrumentationMode="$(ClockworkInstrumentationMode)"
			StrongNameKeyPath="$(ClockworkStrongNameKeyPath)"
			TargetRuntime="$(ClockworkTargetRuntime)"
			EntryAssemblyName="$(ClockworkEntryAssemblyName)"
			ManifestPath="$(ClockworkManifestPath)"
			CachePath="$(ClockworkSuccessPath)">
			<Output TaskParameter="ResolvedManifestPath" PropertyName="ClockworkResolvedManifestPath" />
			<Output TaskParameter="WasIncremental" PropertyName="ClockworkWasIncremental" />
		</ClockworkInstrumentTask>

		<Message Importance="normal" Text="Clockwork: manifest at '$(ClockworkResolvedManifestPath)' (incremental: $(ClockworkWasIncremental))" />
	</Target>

</Project>
