<Project>
	<PropertyGroup>
		<ClockworkInstrumentationTaskAssembly>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../src/Clockwork/src/Clockwork.Instrumentation.Build/bin/$(Configuration)/net10.0/Clockwork.Instrumentation.Build.dll'))</ClockworkInstrumentationTaskAssembly>
		<ClockworkIntermediateRoot>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\clockwork\</ClockworkIntermediateRoot>
		<ClockworkUninstrumentedTestDirectory>$(ClockworkIntermediateRoot)source\</ClockworkUninstrumentedTestDirectory>
		<ClockworkStagingDirectory>$(ClockworkIntermediateRoot)instrumented\</ClockworkStagingDirectory>
		<ClockworkManifestPath>$(ClockworkIntermediateRoot)clockwork.manifest.json</ClockworkManifestPath>
		<ClockworkSuccessPath>$(ClockworkIntermediateRoot)clockwork.$(ClockworkInstrumentationMode).success</ClockworkSuccessPath>
		<ClockworkModeStampPath>$(ClockworkIntermediateRoot)clockwork.mode</ClockworkModeStampPath>
	</PropertyGroup>

	<Import Project="..\..\src\Clockwork\src\Clockwork.Instrumentation.Build\build\Clockwork.Instrumentation.Build.targets" />
</Project>
