<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>gRPC transport for RAPID membership, based on Reuben Bond’s RapidCluster.</Description>
    <RootNamespace>RapidCluster.Grpc</RootNamespace>
    <PackageId>ManagedCode.Orleans.RapidMembership.Grpc</PackageId>
    <PackageTags>dotnet;orleans;rapid;membership;grpc;transport;managedcode</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RapidCluster.Unit.Tests" />
    <InternalsVisibleTo Include="ManagedCode.Orleans.RapidMembership" />
    <InternalsVisibleTo Include="ManagedCode.Orleans.RapidMembership.Tests" />
    <InternalsVisibleTo Include="RapidCluster.Integration.Tests" />
    <InternalsVisibleTo Include="RapidCluster.Simulation.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RapidCluster.Core\RapidCluster.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\rapid_service.proto" GrpcServices="Both" AdditionalImportDirs="..\RapidCluster.Core\Protos" />
  </ItemGroup>
</Project>
